# ============================================================
node_modules/
.env
.env.local
.env.*.local
!.env.example

# ============================================================
# Backend (Django)
# ============================================================
# Entorno virtual
backend/venv/
backend/env/
backend/venv.bak/
backend/env.bak/

# Archivos compilados de Python
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Bases de datos SQLite
*.db
*.sqlite3
database/*.sqlite3
backend/*.db

# Estáticos y media (regenerables)
backend/staticfiles/
backend/static_root/
backend/media/
backend/mediafiles/

# Configuración sensible
backend/.env
backend/.env.backup
backend/.env.production

# Logs y archivos locales
*.log
backend/*.log
backend/logs/
backend/local_settings.py

# ============================================================
# Frontend (SvelteKit)
# ============================================================
frontend/node_modules/
frontend/.svelte-kit/
frontend/build/
frontend/dist/
frontend/.env
frontend/.env.*
!.env.example
frontend/.vercel/
frontend/.netlify/
frontend/.output/
frontend/.DS_Store
frontend/.vscode/
frontend/.idea/

# ============================================================
# Logs y temporales
# ============================================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.seed
*.pid.lock
.heartbeat

# ============================================================
# Respaldos y caché
# ============================================================
*.bak
*.backup
*.cache
.cache/
*.code-workspace
.history/
.snapshots/

# ============================================================
